// mise run types:src: tsc type-checks eslint.config.js as JSDoc-checked JavaScript and
// vite.config.ts, which name node's types through the packages they import, without emitting.
// The suite isn't included: tsconfig.test.json checks it (mise run types:test). skipLibCheck: the
// declarations the ESLint packages ship name types they don't install.
// Adapted from spike-html-apps (529ec52): tsconfig.json, its inputs the site's configs.
// From spike-html-hosting (cb0511c): tsconfig.json.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["eslint.config.js", "vite.config.ts"]
}
