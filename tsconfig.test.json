// mise run types:test: tsc type-checks the suite under test/, the TypeScript node --test runs
// under node's type stripping, and the capture file, scripts/screenshots.config.ts, which runs
// under the same stripping, under node's resolution, without emitting.
// Adapted from spike-html-apps (529ec52): tsconfig.test.json.
// Adapted from spike-html-hosting (cb0511c): tsconfig.test.json, with scripts/ checked with the
// suite.
// Adapted from spike-html-hosting-architecture (27d70e1): tsconfig.test.json, its options the
// SDK's base.
// From spike-html-hosting-sdk (v0.1.0): template/tsconfig.test.json.
{
  "extends": "@jaimestill/spike-html-hosting-sdk/tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["test/**/*.ts", "scripts/**/*.ts"]
}
