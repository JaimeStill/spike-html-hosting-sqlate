// mise run types:test: tsc type-checks the suite under test/, the TypeScript node --test runs
// under node's type stripping, against node's types and the tooling's declarations, without
// emitting. The browser tier imports vite.config.ts's base, so the config is checked here under
// node's resolution too. The suite runs on node alone, so no DOM library: what it runs in the page
// is expression text.
// Adapted from spike-html-apps (529ec52): tsconfig.test.json.
// From spike-html-hosting (cb0511c): tsconfig.test.json.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "checkJs": false
  },
  "include": ["test/**/*.ts"]
}
